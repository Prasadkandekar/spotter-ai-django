# Fuel Route Planner - Environment Variables
# Copy this to .env and customize with your values

# IMPORTANT: Update the User-Agent with YOUR contact information
# OpenStreetMap requires this to comply with their usage policy
# Format: AppName/Version (Purpose; +URL; contact@email.com)
HTTP_USER_AGENT="FuelRoutePlanner/1.0 (Development Testing; +https://github.com/yourusername/fuel-planner; your-email@example.com)"

# Alternative: Use your own OSRM instance to avoid rate limits
# OSRM_BASE_URL="https://your-osrm-instance.com"

# Alternative: Use your own Nominatim instance
# NOMINATIM_URL="https://your-nominatim-instance.com/search"

# Referer header (some services require this)
REFERER="http://localhost:8000"

# Django settings
DJANGO_SECRET_KEY="your-secret-key-here-change-in-production"
DJANGO_DEBUG="1"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
